# Copy to .env and fill in. .env is gitignored - deployment specifics live there only.

POSTGRES_PASSWORD=change-me

# OpenAI-compatible multimodal embeddings endpoint. Must be reached DIRECTLY (not via a
# gateway): multimodal (image+text) embeddings use a messages-format request that
# gateways such as LiteLLM reject on /v1/embeddings.
EMBED_URL=http://your-embedding-server:8000
EMBED_MODEL=Qwen/Qwen3-VL-Embedding-8B
EMBED_DIM=1024                 # must match vector(N) in initdb/01-schema.sql
EMBED_API_KEY=                 # optional bearer for EMBED_URL

# OpenAI-compatible multimodal chat endpoint used for page transcription. Routing this
# through a gateway works fine and gives per-key telemetry.
VLM_URL=http://your-gateway-or-vlm:4000
VLM_MODEL=your-vlm-model-name
VLM_API_KEY=                   # optional bearer for VLM_URL (e.g. a gateway virtual key)

# Name of the parsing recipe in effect: this release's parser code, the VLM model behind
# VLM_URL, and the Gotenberg image and fonts. Any string works; a memorable name beats a
# number (e.g. 2026-09-gfm-prompt-v2). Change it DELIBERATELY whenever any of those change:
# every file parsed under another name becomes incomplete, pings answer 404, feeds
# re-deliver, and the content is re-parsed on arrival while the old chunks are
# garbage-collected. Too many variables affect the output for this to be derived
# automatically, so a re-index is always a named, operator-triggered event.
PARSER_VERSION=fatdefault

# Parse concurrency: two limits, both for the whole process. VLM_CONCURRENCY is the number
# of pages and images in flight against VLM_URL at any moment, whatever files or deliveries
# they belong to - one shared pool, so this is exactly the load fatingest puts on the model
# (mind the model's other users and its own sequence limit). FILE_CONCURRENCY is the number
# of files being parsed at once, an archive's members counted one by one; a file's renders
# stay in memory until its commit, so this bounds memory (worst case: this many times the
# largest file's renders). Files that need no VLM - text, spreadsheets, pages read from
# their text layer - only ever take a file slot. Keep FILE_CONCURRENCY at least as large as
# VLM_CONCURRENCY, or a delivery of one-page files cannot fill the pool.
VLM_CONCURRENCY=8
FILE_CONCURRENCY=8

# The VLM's answer for a page or image with nothing on it. It is written into the prompt
# and compared against the response; a match becomes a chunk with empty text and
# meta.status "blank", which is never embedded or ranked. Any string the model will
# reproduce verbatim works. Part of the recipe: change it together with PARSER_VERSION.
VLM_BLANK_TOKEN=<blank>

# The largest share of a page's area that may be covered by drawn marks - images, vector
# graphics, annotations such as stamps, notes or form fields - for the page still to be read
# from its text layer alone, skipping the VLM. 0 (the default) means exactly nothing drawn:
# any mark, however small, sends the page to the VLM. Raising it (0.005 is half a percent:
# decorative rules, small logos, page-number boxes) is an explicit decision that marks of
# that size may go undescribed in the text; the render still shows them. Part of the
# recipe: change it together with PARSER_VERSION.
VLM_VISUAL_THRESHOLD=0

# The one prompt every VLM call uses - for a document page with its text layer as support,
# and for a picture with none. The built-in prompt.md ships in the image; to use your own,
# mount the file into the api container and set its path here. It must contain the two
# placeholders {support} (the extracted text) and {blank} (filled from VLM_BLANK_TOKEN, so
# instruction and check always agree); the service refuses to start otherwise. Part of
# the recipe: change it together with PARSER_VERSION.
VLM_PROMPT_FILE=

# Authorization (authentication is your reverse proxy's job). If set, /v1/ingest/* and /v1/gc
# (WRITE_PRINCIPALS) and /v1/search (READ_PRINCIPALS) require the proxy-set principal
# header to match one of the listed principals; /health is never gated. The proxy MUST
# set/override PRINCIPAL_HEADER itself - never pass it through from clients. Empty =
# open, for deployments on a trusted network only.
PRINCIPAL_HEADER=X-Key-Alias
WRITE_PRINCIPALS=
READ_PRINCIPALS=
